---
import BaseLayout from './BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import CTASection from '@/components/CTASection.astro'; import { site } from '@/data/site';
const { service } = Astro.props; const path = `/servicios/${service.slug}/`;
const jsonLd = [{'@context':'https://schema.org','@type':'Service',name:service.title,description:service.short,areaServed:['La Zubia','Granada','Cájar','Ogíjares','Armilla','Huétor Vega','Monachil']},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:site.siteUrl+'/'},{'@type':'ListItem',position:2,name:'Servicios',item:site.siteUrl+'/servicios/'},{'@type':'ListItem',position:3,name:service.title,item:site.siteUrl+path}]}];
---
<BaseLayout title={`${service.title} | Flopitec`} description={service.short} path={path} jsonLd={jsonLd} backgroundDesktop={service.image} backgroundMobile={service.image}><Breadcrumbs items={[{label:'Servicios',href:'/servicios/'},{label:service.title,href:path}]}/><article><header class="page-intro"><div class="container"><p class="page-label">{service.category}</p><h1>{service.title}</h1><p class="page-intro__lede">{service.short}</p></div></header><section class="editorial-section"><div class="container service-layout"><div><h2>Qué podemos revisar</h2><ul>{service.items.map(item=><li>{item}</li>)}</ul><h2>Cómo trabajamos</h2><p>Explicamos el problema de forma sencilla, valoramos opciones reales y no recomendamos reparaciones que no compensan por valor del equipo, coste o uso previsto.</p></div><img src={service.image} alt="" width="720" height="540" loading="eager" decoding="async"/></div></section></article><CTASection/></BaseLayout>
<style>.service-layout{display:grid;grid-template-columns:1fr .8fr;gap:clamp(2rem,6vw,5rem);align-items:start}.service-layout h2{margin-top:2rem;font-size:clamp(1.6rem,3vw,2.2rem)}.service-layout h2:first-child{margin-top:0}.service-layout :is(p,li){color:var(--muted);line-height:1.7}.service-layout ul{margin-top:1rem;padding-left:1.2rem}.service-layout img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:2px}@media(max-width:700px){.service-layout{grid-template-columns:1fr}}</style>
