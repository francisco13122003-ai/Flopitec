---
const { post, index = 0 } = Astro.props;
---
<article class="blog-entry"><span class="blog-entry__index" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><p class="page-label">Guía práctica</p><h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2><p>{post.description}</p></div><a class="text-link" href={`/blog/${post.slug}/`} aria-label={`Leer ${post.title}`}>Leer <span aria-hidden="true">→</span></a></article>
<style>.blog-entry{display:grid;grid-template-columns:3rem minmax(0,1fr) auto;gap:clamp(1rem,3vw,2rem);align-items:start;padding:clamp(1.5rem,4vw,2.5rem) 0;border-top:1px solid var(--line)}.blog-entry__index{color:#777;font-size:.78rem}.blog-entry h2{max-width:28ch;margin-top:.5rem;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:950;line-height:1.08}.blog-entry h2 a{text-decoration:none}.blog-entry p:not(.page-label){max-width:45rem;margin-top:.8rem;color:var(--muted);line-height:1.65}@media(max-width:600px){.blog-entry{grid-template-columns:2rem 1fr}.blog-entry>.text-link{grid-column:2}}</style>
