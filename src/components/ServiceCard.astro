---
const { service } = Astro.props;
const href = `/servicios/${service.slug}/`;
---
<article class="service-entry">
  <a class="service-entry__image" href={href} aria-label={`Ver ${service.title}`}>
    <img src={service.image} alt="" width="640" height="420" loading="lazy" decoding="async" />
  </a>
  <div class="service-entry__body">
    <h3><a href={href}>{service.title}</a></h3>
    <p>{service.phrase}</p>
    <ul aria-label={`Incluye ${service.title}`}>
      {service.featured.map((item) => <li>{item}</li>)}
    </ul>
    <a class="text-link" href={href}>Ver servicio <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .service-entry{display:grid;grid-template-columns:minmax(8rem,.42fr) minmax(0,1fr);min-height:17rem;border-top:1px solid var(--line)}
  .service-entry__image{min-height:100%;overflow:hidden;background:#111}.service-entry img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.service-entry__image:hover img{transform:scale(1.025)}
  .service-entry__body{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(1.25rem,3vw,2rem);border-left:1px solid var(--line)}
  h3{font-size:clamp(1.35rem,2.5vw,1.9rem);font-weight:950;line-height:1.08}h3 a{text-decoration:none}p{margin-top:.8rem;color:var(--muted);line-height:1.6}
  ul{display:flex;flex-wrap:wrap;gap:.4rem 1rem;margin:.9rem 0 1.4rem;padding:0;list-style:none;color:#d1d1d1;font-size:.9rem}li::before{content:'—';margin-right:.35rem;color:var(--accent)}.text-link{margin-top:auto}
  @media(max-width:600px){.service-entry{grid-template-columns:1fr}.service-entry__image{min-height:12rem;aspect-ratio:16/9}.service-entry__body{border-left:0}}
</style>
