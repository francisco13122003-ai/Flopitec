---
import { business } from '@/data/business';
import { navigation } from '@/data/navigation';
import { site } from '@/data/site';
const formatPhone = (phone: string) => phone.replace(/(\d{3})(\d{3})(\d{3})$/, '$1 $2 $3');
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-footer__identity" href="/" aria-label={`${business.commercialName}, inicio`}>
        <img src={site.logoImage} alt="" width="56" height="56" loading="lazy" decoding="async" />
        <span><strong>Flopitec</strong><span>Servicios Informáticos</span></span>
      </a>
      <p>Desde 2001, revisamos y reparamos equipos en La Zubia. Atendemos a particulares, autónomos y empresas.</p>
    </div>
    <nav class="site-footer__navigation" aria-labelledby="footer-navigation-title">
      <h2 id="footer-navigation-title">Enlaces</h2>
      <ul>{navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <div class="site-footer__contact">
      <h2>Contacto</h2>
      <address>
        <a href={business.mapsUrl}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
          <span>{business.address.street}<br />{business.address.postalCode} {business.address.locality}, {business.address.province}</span>
        </a>
        <a href={business.phone.mainHref}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 3 4 1 1 5-3 2a15 15 0 0 0 6 6l2-3 5 1 1 4c-1 5-8 2-12-2S2 7 5 3Z"/></svg>
          <span>{formatPhone(business.phone.main)}</span>
        </a>
        <a href={business.whatsapp.url} aria-label={`WhatsApp: ${formatPhone(business.whatsapp.label)}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a9.5 9.5 0 0 1-14 8.4L2 22l1.7-5.3A9.5 9.5 0 1 1 21 11.5Z"/><path d="m8 7 1 3-1 1a9 9 0 0 0 5 5l1-1 3 1"/></svg>
          <span>{formatPhone(business.whatsapp.label)}</span>
        </a>
        <a href={business.emailHref}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><path d="m3 6 9 7 9-7"/></svg>
          <span>{business.email}</span>
        </a>
      </address>
    </div>
    <div class="site-footer__visit">
      <h2>Nuestro taller</h2>
      <a class="site-footer__hours" href="/contacto/#horario">Nuestro horario <span aria-hidden="true">↗</span></a>
      <a href={business.mapsUrl}>Cómo llegar <span aria-hidden="true">↗</span></a>
      <p class="site-footer__slogan">{business.slogan}<span aria-hidden="true"></span></p>
    </div>
  </div>
  <div class="site-footer__rule">
    <div class="container site-footer__bottom">
      <span>© {new Date().getFullYear()} {business.commercialName}. Todos los derechos reservados.</span>
      <nav aria-label="Enlaces legales"><a href="/aviso-legal/">Aviso legal</a><a href="/privacidad/">Política de privacidad</a><a href="/cookies/">Política de cookies</a></nav>
    </div>
  </div>
</footer>

<style>
  .site-footer{--heading-section-weight:600;border-top:1px solid #383b3e;background:#17191b;color:#c8c9cb}
  .site-footer__grid{display:grid;grid-template-columns:1.3fr 1.05fr 1.2fr .75fr;gap:clamp(1.5rem,3vw,3rem);padding-block:2.6rem 2.4rem}
  .site-footer__grid>*{min-width:0}
  .site-footer__identity{display:inline-flex;align-items:center;gap:.5rem;text-decoration:none;color:var(--ink)}
  .site-footer__identity img{flex:0 0 3.4rem;width:3.4rem;height:3.4rem;margin-left:-.6rem}
  .site-footer__identity strong{display:block;font-size:1.35rem;line-height:1.2;font-weight:650}
  .site-footer__identity span span{display:block;margin-top:.2rem;font-size:.69rem;color:#c8c9cb}
  .site-footer__brand p{max-width:34ch;margin:1rem 0 0;font-size:.85rem;line-height:1.7}
  h2{margin:0 0 1rem;font-size:.84rem;color:#e1e2e3}
  a{max-width:100%;text-decoration:none;text-underline-offset:.25em}
  a:hover{color:var(--accent);text-decoration:underline}
  .site-footer__identity:hover{text-decoration:none}
  .site-footer__navigation ul{display:grid;grid-template-columns:1fr 1.2fr;gap:.55rem 1rem;list-style:none;margin:0;padding:0;font-size:.84rem;line-height:1.45}
  address{display:grid;gap:.65rem;font-style:normal;font-size:.84rem;line-height:1.55}
  address a{display:grid;grid-template-columns:1rem minmax(0,1fr);gap:.75rem;align-items:start}
  address span{overflow-wrap:anywhere}
  address svg{width:1rem;height:1rem;margin-top:.15rem;fill:none;stroke:var(--accent);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .site-footer__visit>a{display:block;width:fit-content;margin-bottom:.7rem;font-size:.84rem;line-height:1.45}
  .site-footer__hours{color:#f3f3f3}
  .site-footer__slogan{max-width:16ch;margin:1.5rem 0 0;color:#e3e3e3;font-size:1rem;line-height:1.45}
  .site-footer__slogan>span{display:block;width:3.3rem;height:3px;margin-top:.7rem;background:var(--accent)}
  .site-footer__rule{border-top:1px solid #303336}
  .site-footer__bottom{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem 2rem;padding-block:1.15rem;color:#b4b6b8;font-size:.73rem;line-height:1.65}
  .site-footer__bottom nav{display:flex;flex-wrap:wrap;gap:.55rem 1rem}
  .site-footer__bottom nav a+a{padding-left:1rem;border-left:1px solid #4a4c4e}
  @media(max-width:1050px){.site-footer__grid{grid-template-columns:1fr 1fr;gap:2.5rem 3rem}.site-footer__brand p{max-width:39ch}}
  @media(max-width:520px){.site-footer__grid{grid-template-columns:1fr;gap:1.8rem;padding-block:2rem}.site-footer__grid>*+*{padding-top:1.5rem;border-top:1px solid #303336}.site-footer__navigation ul{grid-template-columns:1fr 1fr;gap:.75rem 1rem}.site-footer__slogan{max-width:26ch}.site-footer__bottom nav{column-gap:.8rem}.site-footer__bottom nav a+a{padding-left:.8rem}}
</style>
