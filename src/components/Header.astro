---
import { navigation } from '@/data/navigation';
import { business } from '@/data/business';
---

<header class="site-header">
  <nav class="container site-header__inner" aria-label="Menú principal">
    <a href="/" class="site-header__brand" aria-label="Flopitec Servicios Informáticos - Inicio">
      <img src="/images/flopitec-logo.svg" alt="Flopitec Servicios Informáticos" width="174" height="36" />
    </a>
    <div class="site-header__links">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <a class="site-header__cta" href={business.whatsapp.url} aria-label="Contactar con Flopitec por WhatsApp">WhatsApp</a>
  </nav>
</header>

<style>
  .site-header{position:sticky;top:0;z-index:40;border-bottom:1px solid #474747;background:rgb(5 5 5/.96)}
  .site-header__inner{display:grid;grid-template-areas:"brand cta" "links links";grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:.55rem .75rem;min-height:4.45rem;padding-top:.55rem}
  .site-header__brand{grid-area:brand;display:inline-flex;width:max-content;max-width:100%;padding:.35rem 0;border-radius:2px}
  .site-header__brand img{display:block;width:auto;height:2rem;max-width:min(10rem,54vw)}
  .site-header__cta{grid-area:cta;display:inline-flex;min-height:2.75rem;align-items:center;justify-content:center;padding:.55rem .72rem;border:1px solid color-mix(in srgb,var(--accent) 58%,#3a2718);border-radius:3px;background:color-mix(in srgb,var(--accent) 16%,transparent);color:var(--ink);font-size:.78rem;font-weight:720;line-height:1;text-decoration:none;white-space:nowrap}
  .site-header__cta:hover,.site-header__cta:focus-visible{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 24%,transparent);color:#fff}
  .site-header__links{grid-area:links;display:flex;width:calc(100% + 2rem);margin-left:-1rem;padding:0 1rem;overflow-x:auto;border-top:1px solid #242424;scrollbar-width:thin}
  .site-header__links a{flex:0 0 auto;padding:.8rem .7rem .75rem;border-bottom:2px solid transparent;color:var(--muted);font-size:.8rem;font-weight:700;text-decoration:none;white-space:nowrap}
  .site-header__links a:hover,.site-header__links a:focus-visible{border-bottom-color:var(--accent);color:var(--ink)}
  @media (min-width:980px){.site-header__inner{grid-template-areas:"brand links cta";grid-template-columns:auto 1fr auto;gap:.65rem 1rem;min-height:5rem;padding-top:0}.site-header__brand img{height:2.25rem;max-width:100%}.site-header__links{justify-content:center;width:auto;margin:0;padding:0;border:0;overflow:visible}.site-header__links a{padding:1.75rem .55rem 1.6rem;font-size:.78rem}.site-header__cta{min-height:2.75rem;padding:.55rem 1.05rem;border-color:var(--accent);background:var(--accent);color:#111;font-size:.82rem;font-weight:760}.site-header__cta:hover,.site-header__cta:focus-visible{background:#ff8a34;border-color:#ff8a34;color:#111}}
</style>
