---
// Aviso temporal de vacaciones: eliminar este componente después del 17 de agosto.
import { schedules } from '@/data/business';

const summerSchedule = schedules.summer.lines;
const weekendDays = summerSchedule
  .slice(1)
  .map((line) => line.split(' ')[0])
  .join(' y ')
  .toLowerCase();
---

<div class="vacation-notice" data-vacation-notice>
  <div class="vacation-notice__overlay">
    <section
      class="vacation-notice__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="vacation-notice-title"
    >
      <p class="vacation-notice__eyebrow">Aviso importante</p>
      <h2 id="vacation-notice-title">Cerrado por vacaciones</h2>
      <p>Estamos cerrados por vacaciones.</p>
      <p class="vacation-notice__return">Volvemos el lunes 17 de agosto</p>
      <p>con nuestro horario habitual de verano:</p>
      <div class="vacation-notice__schedule">
        <p>{summerSchedule[0]}</p>
        <p>{weekendDays}: cerrado</p>
      </div>
      <p>¡Nos vemos a la vuelta!</p>
      <button type="button" data-vacation-notice-close>Entendido</button>
    </section>
  </div>
</div>

<script>
  // Estado temporal del aviso: se conserva únicamente durante la sesión del navegador.
  const storageKey = 'flopitec-vacation-notice-accepted';
  const notice = document.querySelector<HTMLElement>('[data-vacation-notice]');
  const closeButton = notice?.querySelector<HTMLButtonElement>('[data-vacation-notice-close]');
  const backgroundElements = notice
    ? [...document.body.children].filter(
        (element): element is HTMLElement => element instanceof HTMLElement && element !== notice && !element.hasAttribute('inert'),
      )
    : [];

  if (notice && closeButton) {
    if (sessionStorage.getItem(storageKey) === 'true') {
      notice.remove();
    } else {
      document.body.classList.add('vacation-notice-open');
      backgroundElements.forEach((element) => element.setAttribute('inert', ''));
      closeButton.focus();

      closeButton.addEventListener('click', () => {
        sessionStorage.setItem(storageKey, 'true');
        document.body.classList.remove('vacation-notice-open');
        backgroundElements.forEach((element) => element.removeAttribute('inert'));
        notice.remove();
      });
    }
  }
</script>

<style>
  :global(body.vacation-notice-open) {
    overflow: hidden;
  }

  .vacation-notice {
    position: fixed;
    inset: 0;
    z-index: 10000;
  }

  .vacation-notice__overlay {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow-y: auto;
    padding: 1rem;
    background: rgb(0 0 0 / 72%);
  }

  .vacation-notice__dialog {
    width: min(100%, 30rem);
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    padding: clamp(1.5rem, 5vw, 2.25rem);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 1.25rem;
    background: #111;
    color: #f5f5f5;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 55%);
    text-align: center;
  }

  .vacation-notice__dialog p {
    margin: 0 0 0.75rem;
    line-height: 1.55;
  }

  .vacation-notice__eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vacation-notice__dialog h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.65rem, 7vw, 2.25rem);
    line-height: 1.1;
  }

  .vacation-notice__return {
    color: var(--accent);
    font-weight: 800;
  }

  .vacation-notice__schedule {
    margin: 1rem 0;
    padding: 0.85rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 6%);
  }

  .vacation-notice__schedule p:last-child {
    margin-bottom: 0;
  }

  .vacation-notice__dialog button {
    width: 100%;
    min-height: 3rem;
    margin-top: 0.5rem;
    border: 0;
    border-radius: 0.75rem;
    background: var(--accent);
    color: #111;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .vacation-notice__dialog button:hover {
    background: #ff9a40;
  }

  .vacation-notice__dialog button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 375px) {
    .vacation-notice__overlay {
      padding: 0.75rem;
    }

    .vacation-notice__dialog {
      max-height: calc(100dvh - 1.5rem);
      padding: 1.25rem;
    }
  }
</style>
