---
import { business } from '@/data/business';
const { title='¿Hablamos de tu equipo?', text='Cuéntanos qué ocurre por WhatsApp o ven al taller. Te orientamos con claridad antes de decidir.' } = Astro.props;
---
<section class="editorial-cta"><div class="container editorial-cta__grid"><div><p class="page-label">Siguiente paso</p><h2>{title}</h2></div><div><p>{text}</p><nav aria-label="Opciones de contacto"><a class="btn btn-primary" href={business.whatsapp.url}>WhatsApp</a><a class="text-link" href="/contacto/">Ver todas las vías <span aria-hidden="true">→</span></a></nav></div></div></section>
<style>
  .editorial-cta{padding:clamp(3rem,7vw,5.5rem) 0;border-block:1px solid var(--line);background:#0c0c0c}.editorial-cta__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.72fr);gap:clamp(2rem,7vw,6rem);align-items:end}.editorial-cta h2{max-width:14ch;margin-top:.9rem;font-size:clamp(2rem,5vw,4rem);font-weight:950;line-height:.98;letter-spacing:-.045em}.editorial-cta p:not(.page-label){color:var(--muted);line-height:1.7}.editorial-cta nav{display:flex;align-items:center;gap:1.25rem;margin-top:1.5rem}@media(max-width:700px){.editorial-cta__grid{grid-template-columns:1fr}.editorial-cta nav{align-items:flex-start;flex-direction:column}}
</style>
