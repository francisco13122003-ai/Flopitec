---
import { business } from '@/data/business';

const { title, subtitle } = Astro.props;
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="container home-hero__grid">
    <div class="home-hero__copy">
      <p class="home-hero__kicker">Taller técnico · La Zubia</p>
      <h1 id="home-title">{title}</h1>
      <p class="home-hero__intro">{subtitle}</p>
      <div class="home-hero__actions">
        <a class="home-action home-action--primary" href={business.whatsapp.url}>Escribir por WhatsApp</a>
        <a class="home-action home-action--secondary" href={business.phone.mainHref}>Llamar al taller</a>
        <a class="home-hero__map" href={business.mapsUrl}>Cómo llegar <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="home-hero__media">
      <img src="/images/flopitec-equipo-reparando.webp" alt="Equipo de Flopitec reparando un dispositivo en el taller" width="720" height="450" loading="eager" decoding="async" fetchpriority="high" />
      <figcaption>{business.slogan}</figcaption>
    </figure>
  </div>
</section>

<style>
  .home-hero{overflow:hidden;padding:clamp(2.75rem,7vw,6.5rem) 0 4rem;border-bottom:1px solid var(--line);background:rgb(5 5 5/.82)}
  .home-hero__grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));align-items:center;gap:1rem}
  .home-hero__copy{grid-column:1/-1;padding-bottom:.5rem}
  .home-hero__kicker{margin:0 0 1.25rem;padding-left:1rem;border-left:3px solid var(--accent);color:var(--muted);font-size:.74rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
  h1{max-width:14ch;margin:0;font-size:clamp(2.65rem,7vw,5.5rem);font-weight:900;letter-spacing:-.055em;line-height:.96;text-wrap:balance}
  .home-hero__intro{max-width:37rem;margin:1.75rem 0 0;color:#d0d0d0;font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.55}
  .home-hero__actions{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem 1.4rem;margin-top:2rem}
  .home-action{display:inline-flex;min-height:3rem;align-items:center;justify-content:center;padding:.7rem 1rem;border:1px solid var(--line);border-radius:3px;font-weight:800;text-decoration:none;transition:background-color .18s ease,border-color .18s ease,color .18s ease}
  .home-action--primary{border-color:var(--accent);background:var(--accent);color:#101010}
  .home-action--primary:hover{background:#ff8a32;border-color:#ff8a32}
  .home-action--secondary:hover{border-color:#777;background:#191919}
  .home-hero__map{padding:.45rem 0;color:#e5e5e5;font-weight:700;text-underline-offset:.35rem}
  .home-hero__map:hover{color:var(--accent)}
  .home-hero__media{position:relative;grid-column:1/-1;margin:1.75rem 0 0;border-top:1px solid var(--line)}
  .home-hero__media img{display:block;width:100%;height:clamp(15rem,52vw,30rem);object-fit:cover;object-position:center;border-radius:0 0 3px 3px}
  .home-hero__media figcaption{padding:.7rem 0;color:var(--muted);font-size:.76rem;letter-spacing:.06em;text-transform:uppercase}
  @media (min-width:768px){.home-hero__media{margin-right:calc(50% - 50vw)}.home-hero__media img{height:clamp(24rem,48vw,34rem)}.home-hero__media figcaption{padding-right:var(--container-gutter);text-align:right}}
  @media (min-width:900px){.home-hero__grid{min-height:38rem}.home-hero__copy{z-index:2;grid-column:1/span 6;padding-block:2rem}.home-hero__media{grid-column:6/-1;grid-row:1;margin:0 calc(50% - 50vw) 0 -2rem;border-top:0}.home-hero__media::after{position:absolute;inset:0 auto 0 0;width:clamp(8rem,18vw,18rem);background:linear-gradient(90deg,#050505 0%,rgb(5 5 5/.88) 24%,rgb(5 5 5/.36) 66%,transparent 100%);content:'';pointer-events:none}.home-hero__media img{height:clamp(34rem,48vw,44rem)}.home-hero__media figcaption{position:absolute;z-index:1;right:var(--container-gutter);bottom:1rem;padding:.35rem .5rem;background:rgb(5 5 5/.64);color:#d0d0d0}}
  @media (max-width:374px){h1{font-size:2.35rem}.home-action{width:100%}.home-hero__map{width:100%;margin-top:.25rem}}
</style>
