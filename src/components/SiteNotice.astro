---
import { siteNotice } from '@/data/siteNotice';

const storageKey = `flopitec-site-notice-${siteNotice.id}`;
---

{
  siteNotice.enabled && (
    <div class="site-notice" data-site-notice data-storage-key={storageKey} hidden>
      <div class="site-notice__overlay">
        <section
          class="site-notice__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="site-notice-title"
          tabindex="-1"
        >
          <header class="site-notice__header">
            <p class="site-notice__eyebrow">{siteNotice.eyebrow}</p>
            <button class="site-notice__close" type="button" aria-label="Cerrar aviso" data-site-notice-close>
              <span aria-hidden="true">×</span>
            </button>
          </header>

          <div class="site-notice__content">
            <h2 id="site-notice-title">{siteNotice.title}</h2>
            <p class="site-notice__intro">{siteNotice.intro}</p>

            <div class="site-notice__actions">
              <a class="site-notice__primary" href={siteNotice.primaryCta.href} data-site-notice-cta>
                {siteNotice.primaryCta.label}
              </a>
              <a class="site-notice__text-link" href={siteNotice.secondaryCta.href}>
                {siteNotice.secondaryCta.label} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <div class="site-notice__schedule-link">
            <h3>{siteNotice.schedule.title}</h3>
            <a class="site-notice__text-link" href={siteNotice.schedule.href}>
              {siteNotice.schedule.linkLabel} <span aria-hidden="true">→</span>
            </a>
          </div>

          <button class="site-notice__dismiss" type="button" data-site-notice-close>
            {siteNotice.dismissLabel}
          </button>
        </section>
      </div>
    </div>
  )
}

<script>
  const notice = document.querySelector<HTMLElement>('[data-site-notice]');
  const dialog = notice?.querySelector<HTMLElement>('.site-notice__dialog');
  const closeButtons = notice?.querySelectorAll<HTMLButtonElement>('[data-site-notice-close]');
  const primaryCta = notice?.querySelector<HTMLAnchorElement>('[data-site-notice-cta]');
  const storageKey = notice?.dataset.storageKey;

  if (notice && dialog && closeButtons?.length && primaryCta && storageKey) {
    if (sessionStorage.getItem(storageKey) === 'true') {
      notice.remove();
    } else {
      const backgroundElements = [...document.body.children].filter(
        (element): element is HTMLElement =>
          element instanceof HTMLElement && element !== notice && !element.hasAttribute('inert'),
      );

      const markAsViewed = () => sessionStorage.setItem(storageKey, 'true');
      const closeNotice = () => {
        markAsViewed();
        document.body.classList.remove('site-notice-open');
        backgroundElements.forEach((element) => element.removeAttribute('inert'));
        document.removeEventListener('keydown', handleKeydown);
        notice.remove();
      };
      const handleKeydown = (event: KeyboardEvent) => {
        if (event.key === 'Escape') closeNotice();
      };

      notice.hidden = false;
      document.body.classList.add('site-notice-open');
      backgroundElements.forEach((element) => element.setAttribute('inert', ''));
      dialog.focus();

      primaryCta.addEventListener('click', markAsViewed);
      closeButtons.forEach((button) => button.addEventListener('click', closeNotice));
      document.addEventListener('keydown', handleKeydown);
    }
  }
</script>

<style>
  :global(body.site-notice-open) {
    overflow: hidden;
  }

  .site-notice {
    position: fixed;
    inset: 0;
    z-index: 10000;
  }

  .site-notice__overlay {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow-y: auto;
    padding: clamp(0.75rem, 2.5vw, 1.5rem);
    background: rgb(0 0 0 / 78%);
  }

  .site-notice__dialog {
    width: min(calc(100vw - clamp(1.5rem, 5vw, 3rem)), 42rem);
    max-height: calc(100dvh - clamp(1.5rem, 5vw, 3rem));
    overflow-x: hidden;
    overflow-y: auto;
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 2px;
    background: #0b0b0b;
    color: #f5f5f5;
    text-align: left;
  }

  .site-notice__dialog:focus {
    outline: none;
  }

  .site-notice__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: clamp(0.65rem, 2vh, 0.9rem);
    border-bottom: 1px solid var(--line);
  }

  .site-notice__eyebrow {
    position: relative;
    margin: 0;
    padding-left: 0.75rem;
    color: var(--accent);
    font-size: clamp(0.65rem, 1.8vw, 0.75rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .site-notice__eyebrow::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent);
    content: '';
  }

  .site-notice__close {
    display: inline-flex;
    width: 2.75rem;
    min-width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: #ddd;
    font: inherit;
    font-size: 1.65rem;
    line-height: 1;
    cursor: pointer;
  }

  .site-notice__close:hover {
    border-color: var(--line);
    background: rgb(255 255 255 / 5%);
    color: #fff;
  }

  .site-notice__content {
    padding: clamp(1rem, 3.5vh, 1.75rem) 0;
  }

  .site-notice__dialog h2 {
    max-width: 17ch;
    margin: 0 0 clamp(0.75rem, 2vh, 1rem);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .site-notice__intro {
    max-width: 60ch;
    margin: 0;
    color: #d4d4d4;
    font-size: clamp(0.9rem, 2vw, 1rem);
    line-height: 1.55;
  }

  .site-notice__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(1rem, 3vh, 1.5rem);
  }

  .site-notice__primary {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: var(--accent);
    color: #111;
    font-weight: 850;
    line-height: 1.2;
    text-decoration: none;
  }

  .site-notice__primary:hover {
    border-color: #ff9a40;
    background: #ff9a40;
  }

  .site-notice__text-link {
    color: var(--accent);
    font-weight: 750;
    text-underline-offset: 0.25em;
  }

  .site-notice__text-link:not(:hover) {
    text-decoration: none;
  }

  .site-notice__schedule-link {
    padding: clamp(0.9rem, 2.5vh, 1.25rem) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .site-notice__schedule-link h3 {
    margin: 0 0 0.45rem;
    font-size: 1rem;
    line-height: 1.3;
  }

  .site-notice__dismiss {
    min-height: 2.75rem;
    margin-top: clamp(0.5rem, 1.5vh, 0.75rem);
    padding: 0.5rem 0;
    border: 0;
    background: transparent;
    color: #aaa;
    font: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .site-notice__dismiss:hover {
    color: #fff;
  }

  .site-notice__close:focus-visible,
  .site-notice__primary:focus-visible,
  .site-notice__text-link:focus-visible,
  .site-notice__dismiss:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 30rem) {
    .site-notice__actions {
      align-items: stretch;
      flex-direction: column;
      gap: 0.7rem;
    }

    .site-notice__primary {
      width: 100%;
    }

    .site-notice__text-link {
      align-self: flex-start;
      min-height: 2.75rem;
      padding: 0.65rem 0;
    }
  }

  @media (max-height: 700px) {
    .site-notice__dialog {
      padding-block: clamp(0.75rem, 2.5vh, 1.25rem);
    }

    .site-notice__content {
      padding-block: clamp(0.75rem, 2.5vh, 1.15rem);
    }

    .site-notice__dialog h2 {
      margin-bottom: 0.65rem;
      font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    }

    .site-notice__actions {
      margin-top: 0.8rem;
    }

    .site-notice__schedule-link {
      padding-block: 0.7rem;
    }

    .site-notice__dismiss {
      margin-top: 0.25rem;
    }
  }

  @media (max-height: 600px) {
    .site-notice__overlay {
      padding-block: 0.5rem;
    }

    .site-notice__dialog {
      max-height: calc(100dvh - 1rem);
      padding-block: 0.65rem;
    }

    .site-notice__header {
      padding-bottom: 0.4rem;
    }

    .site-notice__content {
      padding-block: 0.6rem;
    }

    .site-notice__dialog h2 {
      font-size: clamp(1.7rem, 4.5vw, 2.15rem);
    }

    .site-notice__intro {
      line-height: 1.4;
    }
  }
</style>
