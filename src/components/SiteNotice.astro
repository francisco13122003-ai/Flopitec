---
import { schedules } from '@/data/business';
import { siteNotice } from '@/data/siteNotice';

const schedule = schedules[siteNotice.scheduleId];
const storageKey = `flopitec-site-notice-${siteNotice.id}`;
---

{
  siteNotice.enabled && (
    <div class="site-notice" data-site-notice data-storage-key={storageKey} hidden>
      <div class="site-notice__overlay">
        <section
          class="site-notice__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="site-notice-title"
        >
          <p class="site-notice__eyebrow">{siteNotice.eyebrow}</p>
          <h2 id="site-notice-title">{siteNotice.title}</h2>
          <p class="site-notice__intro">{siteNotice.intro}</p>

          <div class="site-notice__schedule">
            <h3>{schedule.name}</h3>
            <p class="site-notice__period">{schedule.period}</p>
            {schedule.lines.map((line) => <p>{line}</p>)}
          </div>

          <div class="site-notice__commercial">
            <h3>{siteNotice.commercialTitle}</h3>
            <p>{siteNotice.commercialText}</p>
          </div>

          <div class="site-notice__actions">
            <a href={siteNotice.primaryCta.href} data-site-notice-cta>
              {siteNotice.primaryCta.label}
            </a>
            <button type="button" data-site-notice-close>{siteNotice.dismissLabel}</button>
          </div>
        </section>
      </div>
    </div>
  )
}

<script>
  const notice = document.querySelector<HTMLElement>('[data-site-notice]');
  const closeButton = notice?.querySelector<HTMLButtonElement>('[data-site-notice-close]');
  const primaryCta = notice?.querySelector<HTMLAnchorElement>('[data-site-notice-cta]');
  const storageKey = notice?.dataset.storageKey;

  if (notice && closeButton && primaryCta && storageKey) {
    if (sessionStorage.getItem(storageKey) === 'true') {
      notice.remove();
    } else {
      const backgroundElements = [...document.body.children].filter(
        (element): element is HTMLElement =>
          element instanceof HTMLElement && element !== notice && !element.hasAttribute('inert'),
      );

      const markAsViewed = () => sessionStorage.setItem(storageKey, 'true');
      const closeNotice = () => {
        markAsViewed();
        document.body.classList.remove('site-notice-open');
        backgroundElements.forEach((element) => element.removeAttribute('inert'));
        document.removeEventListener('keydown', handleKeydown);
        notice.remove();
      };
      const handleKeydown = (event: KeyboardEvent) => {
        if (event.key === 'Escape') closeNotice();
      };

      notice.hidden = false;
      document.body.classList.add('site-notice-open');
      backgroundElements.forEach((element) => element.setAttribute('inert', ''));
      primaryCta.focus();

      primaryCta.addEventListener('click', markAsViewed);
      closeButton.addEventListener('click', closeNotice);
      document.addEventListener('keydown', handleKeydown);
    }
  }
</script>

<style>
  :global(body.site-notice-open) {
    overflow: hidden;
  }

  .site-notice {
    position: fixed;
    inset: 0;
    z-index: 10000;
  }

  .site-notice__overlay {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow-y: auto;
    padding: 1rem;
    background: rgb(0 0 0 / 72%);
  }

  .site-notice__dialog {
    width: min(100%, 36rem);
    max-height: calc(100dvh - 2rem);
    overflow-x: hidden;
    overflow-y: auto;
    padding: clamp(1.5rem, 5vw, 2.25rem);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 1.25rem;
    background: #111;
    color: #f5f5f5;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 55%);
    text-align: center;
  }

  .site-notice__dialog p {
    margin: 0 0 0.75rem;
    line-height: 1.55;
  }

  .site-notice__eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-notice__dialog h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.65rem, 7vw, 2.25rem);
    line-height: 1.1;
  }

  .site-notice__intro {
    color: #ddd;
  }

  .site-notice__schedule {
    margin: 1.25rem 0;
    padding: 1rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 6%);
  }

  .site-notice__schedule h3,
  .site-notice__commercial h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }

  .site-notice__schedule .site-notice__period {
    margin-bottom: 0.75rem;
    color: var(--accent);
    font-weight: 700;
  }

  .site-notice__schedule p:last-child,
  .site-notice__commercial p:last-child {
    margin-bottom: 0;
  }

  .site-notice__commercial {
    padding-top: 0.25rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
  }

  .site-notice__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .site-notice__actions a,
  .site-notice__actions button {
    display: inline-flex;
    flex: 1;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-radius: 0.75rem;
    font: inherit;
    font-weight: 800;
    line-height: 1.25;
    cursor: pointer;
  }

  .site-notice__actions a {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #111;
    text-decoration: none;
  }

  .site-notice__actions a:hover {
    background: #ff9a40;
  }

  .site-notice__actions button {
    border: 1px solid rgb(255 255 255 / 30%);
    background: transparent;
    color: #f5f5f5;
  }

  .site-notice__actions button:hover {
    border-color: rgb(255 255 255 / 60%);
    background: rgb(255 255 255 / 8%);
  }

  .site-notice__actions a:focus-visible,
  .site-notice__actions button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 32rem) {
    .site-notice__actions {
      flex-direction: column;
    }
  }

  @media (max-width: 375px) {
    .site-notice__overlay {
      padding: 0.75rem;
    }

    .site-notice__dialog {
      max-height: calc(100dvh - 1.5rem);
      padding: 1.25rem;
    }
  }
</style>
