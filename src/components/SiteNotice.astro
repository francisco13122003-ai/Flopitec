---
import { schedules } from '@/data/business';
import { siteNotice } from '@/data/siteNotice';

const schedule = schedules[siteNotice.scheduleId];
const storageKey = `flopitec-site-notice-${siteNotice.id}`;
---

{
  siteNotice.enabled && (
    <div class="site-notice" data-site-notice data-storage-key={storageKey} hidden>
      <div class="site-notice__overlay">
        <section
          class="site-notice__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="site-notice-title"
          tabindex="-1"
        >
          <header class="site-notice__header">
            <p class="site-notice__eyebrow">{siteNotice.eyebrow}</p>
            <button class="site-notice__close" type="button" aria-label="Cerrar aviso" data-site-notice-close>
              <span aria-hidden="true">×</span>
            </button>
          </header>

          <div class="site-notice__main">
            <div class="site-notice__lead">
              <h2 id="site-notice-title">{siteNotice.title}</h2>
              <p class="site-notice__intro">{siteNotice.intro}</p>
            </div>

            <div class="site-notice__schedule">
              <h3>Horario activo</h3>
              <div class="site-notice__schedule-lines">
                {schedule.lines.map((line) => <p>{line}</p>)}
              </div>
            </div>
          </div>

          <p class="site-notice__workshop-note">
            Fuera de este horario de atención al público, seguimos trabajando en el taller para avanzar en las reparaciones.
          </p>

          <div class="site-notice__commercial">
            <h3>{siteNotice.commercialTitle}</h3>
            <p>{siteNotice.commercialText}</p>
          </div>

          <div class="site-notice__actions">
            <a href={siteNotice.primaryCta.href} data-site-notice-cta>
              {siteNotice.primaryCta.label}
            </a>
            <button type="button" data-site-notice-close>{siteNotice.dismissLabel}</button>
          </div>
        </section>
      </div>
    </div>
  )
}

<script>
  const notice = document.querySelector<HTMLElement>('[data-site-notice]');
  const dialog = notice?.querySelector<HTMLElement>('.site-notice__dialog');
  const closeButtons = notice?.querySelectorAll<HTMLButtonElement>('[data-site-notice-close]');
  const primaryCta = notice?.querySelector<HTMLAnchorElement>('[data-site-notice-cta]');
  const storageKey = notice?.dataset.storageKey;

  if (notice && dialog && closeButtons?.length && primaryCta && storageKey) {
    if (sessionStorage.getItem(storageKey) === 'true') {
      notice.remove();
    } else {
      const backgroundElements = [...document.body.children].filter(
        (element): element is HTMLElement =>
          element instanceof HTMLElement && element !== notice && !element.hasAttribute('inert'),
      );

      const markAsViewed = () => sessionStorage.setItem(storageKey, 'true');
      const closeNotice = () => {
        markAsViewed();
        document.body.classList.remove('site-notice-open');
        backgroundElements.forEach((element) => element.removeAttribute('inert'));
        document.removeEventListener('keydown', handleKeydown);
        notice.remove();
      };
      const handleKeydown = (event: KeyboardEvent) => {
        if (event.key === 'Escape') closeNotice();
      };

      notice.hidden = false;
      document.body.classList.add('site-notice-open');
      backgroundElements.forEach((element) => element.setAttribute('inert', ''));
      dialog.focus();

      primaryCta.addEventListener('click', markAsViewed);
      closeButtons.forEach((button) => button.addEventListener('click', closeNotice));
      document.addEventListener('keydown', handleKeydown);
    }
  }
</script>

<style>
  :global(body.site-notice-open) {
    overflow: hidden;
  }

  .site-notice {
    position: fixed;
    inset: 0;
    z-index: 10000;
  }

  .site-notice__overlay {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow-y: auto;
    padding: clamp(0.75rem, 3vw, 1.5rem);
    background: rgb(0 0 0 / 78%);
  }

  .site-notice__dialog {
    position: relative;
    width: min(100%, 46rem);
    max-height: calc(100dvh - clamp(1.5rem, 6vw, 3rem));
    overflow-x: hidden;
    overflow-y: auto;
    padding: clamp(1.25rem, 4vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: 2px;
    background: #0b0b0b;
    color: #f5f5f5;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 22%);
    text-align: left;
  }

  .site-notice__dialog:focus {
    outline: none;
  }

  .site-notice__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .site-notice__close {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: #ddd;
    font: inherit;
    font-size: 1.65rem;
    line-height: 1;
    cursor: pointer;
  }

  .site-notice__close:hover {
    border-color: var(--line);
    background: rgb(255 255 255 / 5%);
    color: #fff;
  }

  .site-notice__close:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  .site-notice__dialog p {
    margin: 0 0 0.75rem;
    line-height: 1.55;
  }

  .site-notice__eyebrow {
    position: relative;
    padding-left: 0.8rem;
    margin: 0;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-notice__eyebrow::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent);
    content: '';
  }

  .site-notice__main {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(14rem, 0.75fr);
    gap: clamp(1.5rem, 5vw, 3rem);
    padding: clamp(1.5rem, 4vw, 2.25rem) 0;
  }

  .site-notice__dialog h2 {
    margin: 0 0 1.25rem;
    max-width: 14ch;
    font-size: clamp(1.85rem, 5vw, 2.65rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .site-notice__intro {
    max-width: 38ch;
    color: #d4d4d4;
    font-size: 1rem;
  }

  .site-notice__workshop-note {
    padding: 0.15rem 0 0.15rem 1rem;
    border-left: 2px solid var(--accent);
    color: #aaa;
    font-size: 0.9rem;
  }

  .site-notice__schedule {
    align-self: start;
    border-top: 2px solid var(--accent);
  }

  .site-notice__schedule h3,
  .site-notice__commercial h3 {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-notice__schedule h3 {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--accent);
  }

  .site-notice__schedule-lines p {
    margin: 0;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    color: #ddd;
    font-size: 0.9rem;
  }

  .site-notice__schedule p:last-child,
  .site-notice__commercial p:last-child {
    margin-bottom: 0;
  }

  .site-notice__commercial {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .site-notice__commercial h3 {
    margin-bottom: 0.65rem;
    font-size: 1rem;
  }

  .site-notice__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .site-notice__actions a,
  .site-notice__actions button {
    display: inline-flex;
    flex: 1;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-radius: 2px;
    font: inherit;
    font-weight: 800;
    line-height: 1.25;
    cursor: pointer;
  }

  .site-notice__actions a {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #111;
    text-decoration: none;
  }

  .site-notice__actions a:hover {
    border-color: #ff9a40;
    background: #ff9a40;
  }

  .site-notice__actions button {
    border: 1px solid var(--line);
    background: transparent;
    color: #f5f5f5;
  }

  .site-notice__actions button:hover {
    border-color: rgb(255 255 255 / 60%);
    background: rgb(255 255 255 / 8%);
  }

  .site-notice__actions a:focus-visible,
  .site-notice__actions button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 32rem) {
    .site-notice__main {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .site-notice__actions {
      flex-direction: column;
    }
  }

  @media (max-width: 375px) {
    .site-notice__overlay {
      padding: 0.75rem;
    }

    .site-notice__dialog {
      max-height: calc(100dvh - 1.5rem);
      padding: 1.1rem;
    }
  }
</style>
