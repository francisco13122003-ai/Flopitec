---
import { siteNotice } from '@/data/siteNotice';

const storageKey = `flopitec-site-notice-${siteNotice.id}`;
---

{
  siteNotice.enabled && (
    <aside
      class="site-notice"
      role="complementary"
      aria-label="Asistencia técnica"
      data-site-notice
      data-storage-key={storageKey}
      hidden
    >
      <header class="site-notice__header">
        <p class="site-notice__eyebrow">{siteNotice.eyebrow}</p>
        <button class="site-notice__close" type="button" aria-label="Cerrar aviso" data-site-notice-close>
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <div class="site-notice__content">
        <h2>{siteNotice.title}</h2>
        <p class="site-notice__intro">{siteNotice.intro}</p>

        <div class="site-notice__actions">
          <a class="site-notice__primary" href={siteNotice.primaryCta.href} data-site-notice-cta data-site-notice-link>
            {siteNotice.primaryCta.label}
          </a>
          <a class="site-notice__text-link" href={siteNotice.secondaryCta.href} data-site-notice-link>
            {siteNotice.secondaryCta.label} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="site-notice__schedule-link">
        <h3>{siteNotice.schedule.title}</h3>
        <a class="site-notice__text-link" href={siteNotice.schedule.href} data-site-notice-link>
          {siteNotice.schedule.linkLabel} <span aria-hidden="true">→</span>
        </a>
      </div>

      <button class="site-notice__dismiss" type="button" data-site-notice-close>
        {siteNotice.dismissLabel}
      </button>
    </aside>
  )
}

<script>
  const APPEARANCE_DELAY = 3000;
  const notice = document.querySelector<HTMLElement>('[data-site-notice]');
  const closeButtons = notice?.querySelectorAll<HTMLButtonElement>('[data-site-notice-close]');
  const navigationLinks = notice?.querySelectorAll<HTMLAnchorElement>('[data-site-notice-link]');
  const storageKey = notice?.dataset.storageKey;

  if (notice && closeButtons?.length && navigationLinks?.length && storageKey) {
    if (sessionStorage.getItem(storageKey) === 'true') {
      notice.remove();
    } else {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const markAsViewed = () => sessionStorage.setItem(storageKey, 'true');
      const removeNotice = () => {
        document.removeEventListener('keydown', handleKeydown);
        notice.remove();
      };
      const closeNotice = () => {
        markAsViewed();

        if (notice.hidden || reducedMotion.matches) {
          removeNotice();
          return;
        }

        notice.classList.remove('is-visible');
        notice.addEventListener('transitionend', (event) => {
          if (event.propertyName === 'transform') removeNotice();
        });
      };
      const handleKeydown = (event: KeyboardEvent) => {
        if (event.key === 'Escape') closeNotice();
      };

      navigationLinks.forEach((link) => link.addEventListener('click', markAsViewed));
      closeButtons.forEach((button) => button.addEventListener('click', closeNotice));

      window.setTimeout(() => {
        notice.hidden = false;
        window.requestAnimationFrame(() => notice.classList.add('is-visible'));
        document.addEventListener('keydown', handleKeydown);
      }, APPEARANCE_DELAY);
    }
  }
</script>

<style>
  .site-notice {
    position: fixed;
    right: clamp(1rem, 2vw, 2rem);
    bottom: clamp(1rem, 2vw, 2rem);
    z-index: 10000;
    width: min(24rem, calc(100vw - 2rem));
    max-height: 74dvh;
    overflow-x: hidden;
    overflow-y: auto;
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid var(--line);
    border-radius: 2px;
    background: #0b0b0b;
    color: #f5f5f5;
    opacity: 0;
    transform: translateX(calc(100% + 2rem));
    transition:
      opacity 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-notice.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .site-notice__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .site-notice__eyebrow {
    position: relative;
    margin: 0;
    padding-left: 0.7rem;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .site-notice__eyebrow::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent);
    content: '';
  }

  .site-notice__close {
    display: inline-flex;
    width: 2.5rem;
    min-width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    color: #ddd;
    font: inherit;
    font-size: 1.55rem;
    line-height: 1;
    cursor: pointer;
  }

  .site-notice__close:hover {
    border-color: var(--line);
    background: rgb(255 255 255 / 5%);
    color: #fff;
  }

  .site-notice__content {
    padding: 1rem 0 1.15rem;
  }

  .site-notice h2 {
    max-width: 17ch;
    margin: 0 0 0.7rem;
    font-size: clamp(1.65rem, 3vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .site-notice__intro {
    margin: 0;
    color: #d4d4d4;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .site-notice__actions {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .site-notice__primary {
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: var(--accent);
    color: #111;
    font-weight: 850;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .site-notice__primary:hover {
    border-color: #ff9a40;
    background: #ff9a40;
  }

  .site-notice__text-link {
    width: fit-content;
    color: #ddd;
    font-weight: 750;
    text-underline-offset: 0.25em;
  }

  .site-notice__text-link span,
  .site-notice__text-link:hover {
    color: var(--accent);
  }

  .site-notice__text-link:not(:hover) {
    text-decoration: none;
  }

  .site-notice__schedule-link {
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .site-notice__schedule-link h3 {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .site-notice__dismiss {
    min-height: 2.5rem;
    margin-top: 0.35rem;
    padding: 0.4rem 0;
    border: 0;
    background: transparent;
    color: #aaa;
    font: inherit;
    font-size: 0.82rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .site-notice__dismiss:hover {
    color: #fff;
  }

  .site-notice__close:focus-visible,
  .site-notice__primary:focus-visible,
  .site-notice__text-link:focus-visible,
  .site-notice__dismiss:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .site-notice {
      right: 1rem;
      bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
      left: 1rem;
      width: auto;
      max-height: 72dvh;
      padding: 0.85rem 1rem;
      transform: translateY(calc(100% + 2rem));
    }

    .site-notice.is-visible {
      transform: translateY(0);
    }

    .site-notice__content {
      padding-block: 0.8rem 0.9rem;
    }

    .site-notice h2 {
      font-size: clamp(1.45rem, 7vw, 1.8rem);
    }

    .site-notice__intro {
      font-size: 0.84rem;
      line-height: 1.42;
    }

    .site-notice__actions {
      gap: 0.65rem;
      margin-top: 0.8rem;
    }

    .site-notice__primary {
      width: 100%;
    }

    .site-notice__schedule-link {
      padding-block: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-notice,
    .site-notice.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
