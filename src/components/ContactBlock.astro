---
import { business, getActiveSchedule } from '@/data/business';
const schedule = getActiveSchedule();
---
<section class="contact-details editorial-section"><div class="container contact-details__grid"><div><p class="page-label">Taller y contacto</p><h2>Estamos en La Zubia</h2><dl><div><dt>Dirección</dt><dd><a href={business.mapsUrl}>{business.address.full}</a></dd></div><div><dt>Teléfono</dt><dd><a href={business.phone.mainHref}>{business.phone.main}</a><span aria-hidden="true"> · </span><a href={business.phone.secondaryHref}>{business.phone.secondary}</a></dd></div><div><dt>Email</dt><dd><a href={business.emailHref}>{business.email}</a></dd></div></dl><nav aria-label="Acciones de contacto"><a class="btn btn-primary" href={business.whatsapp.url}>Escribir por WhatsApp</a><a class="text-link" href={business.mapsUrl}>Abrir Google Maps →</a></nav></div><div class="schedule"><p class="page-label">Horario activo</p><h2>{schedule.name}</h2><p class="period">{schedule.period}</p><ul>{schedule.lines.map(line=><li>{line}</li>)}</ul></div></div></section>
<style>.contact-details__grid{display:grid;grid-template-columns:1.08fr .92fr;border-top:1px solid var(--line)}.contact-details__grid>div{padding:clamp(1.5rem,4vw,3rem) 0}.contact-details__grid>div+div{padding-left:clamp(1.5rem,4vw,3rem);border-left:1px solid var(--line)}h2{margin-top:.8rem;font-size:clamp(2rem,4vw,3.2rem);font-weight:950;line-height:1}dl{margin-top:2rem}dl div{display:grid;grid-template-columns:7rem 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--line)}dt{color:#888;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}dd{margin:0}dd a{text-decoration:none}nav{display:flex;align-items:center;gap:1.2rem;margin-top:2rem}.period{margin-top:.7rem;color:var(--muted)}ul{margin-top:2rem;padding:0;list-style:none}li{padding:1rem 0;border-top:1px solid var(--line)}@media(max-width:720px){.contact-details__grid{grid-template-columns:1fr}.contact-details__grid>div+div{padding-left:0;border-left:0}.contact-details__grid>div:first-child{padding-bottom:1rem}dl div{grid-template-columns:1fr}.contact-details nav{align-items:flex-start;flex-direction:column}}</style>
