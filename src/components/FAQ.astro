---
const { items } = Astro.props;
---
<div class="faq-list">{items.map((item,index)=><details><summary><span>{String(index+1).padStart(2,'0')}</span>{item.question}</summary><p>{item.answer}</p></details>)}</div>
<style>.faq-list{border-top:1px solid var(--line)}details{border-bottom:1px solid var(--line)}summary{display:grid;grid-template-columns:2.5rem 1fr;gap:1rem;padding:1.35rem 0;cursor:pointer;font-size:clamp(1rem,2vw,1.2rem);list-style:none}summary::-webkit-details-marker{display:none}summary::after{content:'+';grid-column:3;color:var(--accent);font-size:1.4rem}details[open] summary::after{content:'−'}summary span{color:#777;font-size:.75rem;letter-spacing:.08em}p{max-width:48rem;padding:0 3.5rem 1.5rem;color:var(--muted);line-height:1.7}@media(max-width:500px){p{padding-left:0;padding-right:0}}</style>
