---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTASection from '@/components/CTASection.astro';
import { servicePages } from '@/data/services';

const serviceCategories = [
  {
    id: 'informatica-datos-empresas',
    title: 'Informática, datos y empresas',
    description:
      'Soluciones para ordenadores, software, almacenamiento, redes y necesidades informáticas de autónomos y empresas.',
    slugs: [
      'pc-portatiles',
      'software',
      'recuperacion-datos',
      'redes-wifi',
      'impresoras-perifericos',
      'soporte-empresas',
    ],
  },
  {
    id: 'dispositivos-electronica',
    title: 'Dispositivos y electrónica',
    description: 'Revisión y reparación de dispositivos de uso cotidiano y distintos equipos electrónicos.',
    slugs: ['moviles-tablets', 'consolas', 'televisores', 'robots-aspiradores', 'electronica'],
  },
  {
    id: 'telefonia-paqueteria',
    title: 'Telefonía y paquetería',
    description:
      'Gestiones de fibra y móvil, junto con los servicios disponibles en nuestro Punto InPost.',
    slugs: ['telefonia-internet', 'punto-inpost'],
  },
].map((category) => ({
  ...category,
  services: category.slugs
    .map((slug) => servicePages.find((service) => service.slug === slug))
    .filter(Boolean),
}));
---

<BaseLayout
  title="Reparación informática y electrónica en La Zubia | Flopitec"
  description="Reparación informática y electrónica para particulares, autónomos y empresas en el taller de La Zubia. Revisa todos los servicios de Flopitec desde 2001."
  path="/servicios/"
>
  <PageIntro label="Servicios" title="Servicios de reparación informática y electrónica en La Zubia"
    description="Revisamos cada caso, te explicamos las opciones con claridad y recomendamos únicamente lo que realmente necesitas."
    image="/images/flopitec-mostrador.webp" imageAlt="Mostrador de atención de Flopitec" imagePosition="center">
    <nav class="catalog-contents" aria-label="Categorías de servicios">{serviceCategories.map((category) => <a class="text-link" href={`#${category.id}`}>{category.title} <span aria-hidden="true">↓</span></a>)}</nav>
  </PageIntro>
  <div class="editorial-section"><div class="container service-catalog">
        {
          serviceCategories.map((category) => (
            <section aria-labelledby={category.id} class="service-category">
              <header class="editorial-heading">
                <h2 id={category.id} class="text-2xl font-black">
                  {category.title}
                </h2>
                <p class="mt-2 max-w-3xl text-[var(--muted)]">{category.description}</p>
              </header>

              <div class="services-grid">
                {category.services.map((service) => (
                  <ServiceCard service={service} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
  </div>
  <CTASection
    title="¿Qué servicio necesitas?"
    text="Cuéntanos el problema y te orientamos sobre el siguiente paso sin compromiso ni promesas a distancia."
  />
</BaseLayout>
<style>
.catalog-contents{display:flex;flex-wrap:wrap;gap:.7rem 1.3rem;font-size:.9rem}

.service-catalog{display:grid;gap:clamp(3.5rem,8vw,7rem)}.service-category{display:grid;grid-template-columns:minmax(13rem,.35fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,4rem)}.service-category>.editorial-heading{position:sticky;top:7rem;align-self:start}.service-category>.services-grid{display:grid;grid-template-columns:1fr;border:0}.service-category>.services-grid>*{border:0}@media(max-width:760px){.service-category{grid-template-columns:1fr}.service-category>.editorial-heading{position:static}.service-category>.services-grid{grid-template-columns:1fr}}
</style>
