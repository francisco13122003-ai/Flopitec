---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
import { servicePages, getServiceBySlug } from '@/data/services';
import { getCollection } from 'astro:content';
import { isPublicBlogPost, toBlogCardPost } from '@/lib/blog';
import { business } from '@/data/business';
import { site } from '@/data/site';
export function getStaticPaths(){return servicePages.map(service=>({params:{slug:service.slug}}));}
const service = getServiceBySlug(Astro.params.slug!);
if (!service) return Astro.redirect('/servicios/');
const path = `/servicios/${service.slug}/`;
const buildTime = new Date();
const publicBlogPosts = (await getCollection('blog')).filter((post) => isPublicBlogPost(post, buildTime));
const relatedArticles = service.relatedArticleSlugs?.map((slug) => publicBlogPosts.find((post) => post.id === slug)).filter(Boolean).map(toBlogCardPost) ?? [];
const formatLocalParagraph = (paragraph: string) => paragraph.replace('{address}', `${business.address.street}, en ${business.address.locality}, ${business.address.province}`);
const jsonLd = [
  {'@context':'https://schema.org','@type':'WebPage',name:service.h1,description:service.metaDescription,url:site.siteUrl+path},
  {'@context':'https://schema.org','@type':'Service',name:service.h1,description:service.intro,areaServed:['La Zubia','Granada'],provider:{'@id':`${site.siteUrl}/#localbusiness`}},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:site.siteUrl+'/'},{'@type':'ListItem',position:2,name:'Servicios',item:site.siteUrl+'/servicios/'},{'@type':'ListItem',position:3,name:service.h1,item:site.siteUrl+path}]}
];

const isBusiness = service.slug === 'soporte-empresas';
const hasContents = Boolean(service.commonProblems?.length || service.processSteps?.length || relatedArticles.length);
---
<BaseLayout title={service.seoTitle} description={service.metaDescription} path={path} jsonLd={jsonLd} backgroundDesktop={service.image} backgroundMobile={service.image}>
  <Breadcrumbs items={[{ label: 'Servicios', href: '/servicios/' }, { label: service.h1, href: path }]} />
  <PageIntro label="Servicios" title={service.h1} description={service.intro}
    image={isBusiness ? '/images/flopitec-taller-reparacion.webp' : service.image}
    imageAlt={isBusiness ? 'Zona técnica del taller de Flopitec' : ''}
    imagePosition={isBusiness ? 'center' : '65% 78%'}>
    {service.relatedLinks && <nav class="service-links" aria-label="Servicios y guías relacionadas">{service.relatedLinks.map((link) => <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}</nav>}
  </PageIntro>
  {hasContents && <nav class="service-contents" aria-label="En esta página"><div class="container">
    <span>En esta página</span>
    {(service.commonProblems?.length ?? 0) > 0 && <a href="#problemas-habituales">Problemas habituales</a>}
    <a href="#que-revisamos">Reparaciones y mejoras</a>
    {(service.processSteps?.length ?? 0) > 0 && <a href="#revision-equipo">Cómo trabajamos</a>}
    {relatedArticles.length > 0 && <a href="#guias-relacionadas">Guías</a>}
  </div></nav>}
  <div class="service-detail">
    {service.commonProblems && service.commonProblems.length > 0 && <section class="service-detail-section" aria-labelledby="problemas-habituales">
      <div class="container service-detail-section__grid">
        <header><h2 id="problemas-habituales">Problemas de ordenador y portátil que revisamos</h2><p>Un mismo síntoma puede tener distintas causas. Por eso revisamos el equipo antes de recomendar una reparación, una mejora o un cambio de componente. Estos son algunos de los problemas que atendemos habitualmente en nuestro taller.</p></header>
        <div class="service-problems">{service.commonProblems.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
      </div>
    </section>}
    <section class="service-detail-section" aria-labelledby="que-revisamos">
      <div class="container service-detail-section__grid">
        <header><h2 id="que-revisamos">{service.groupHeading}</h2></header>
        <div class="service-offerings">{service.services.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
      </div>
    </section>
    {service.processSteps && service.processSteps.length > 0 && <section class="service-detail-section" aria-labelledby="revision-equipo"><div class="container">
      <h2 id="revision-equipo">Cómo revisamos tu ordenador o portátil</h2>
      <ol class="service-process">{service.processSteps.map((step, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
    </div></section>}
    {service.decisionSection && <section class="service-detail-section" aria-labelledby="decision-reparacion"><div class="container service-detail-section__grid">
      <header><h2 id="decision-reparacion">{service.decisionSection.title}</h2></header>
      <div class="service-reading">{service.decisionSection.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
    </div></section>}
    {service.localSection && <section class="service-detail-section" aria-labelledby="taller-local"><div class="container service-local">
      <figure><img src="/images/flopitec-fachada.webp" alt="Fachada de Flopitec en La Zubia" width="1448" height="1086" loading="lazy" decoding="async" /></figure>
      <div><h2 id="taller-local">{service.localSection.title}</h2>{service.localSection.paragraphs.map((paragraph) => <p>{formatLocalParagraph(paragraph)}</p>)}</div>
    </div></section>}
    {relatedArticles.length > 0 && <section class="service-detail-section" aria-labelledby="guias-relacionadas"><div class="container service-detail-section__grid">
      <header><h2 id="guias-relacionadas">Guías sobre ordenadores y portátiles</h2></header>
      <div class="service-guides">{relatedArticles.map((post) => <article><p class="eyebrow">Guía práctica</p><h3><a href={`/blog/${post.slug}/`}>{post.title} <span aria-hidden="true">→</span></a></h3><p>{post.description}</p></article>)}</div>
    </div></section>}
    {service.relatedServiceLinks && service.relatedServiceLinks.length > 0 && <section class="service-detail-section" aria-labelledby="servicios-relacionados"><div class="container service-detail-section__grid">
      <header><h2 id="servicios-relacionados">Servicios relacionados</h2></header>
      <nav class="service-links" aria-label="Servicios relacionados">{service.relatedServiceLinks.map((link) => <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}</nav>
    </div></section>}
  </div>
  <CTASection title={service.ctaTitle ?? "Cuéntanos tu caso."} text="Cuéntanos qué ocurre o acércate al taller de La Zubia para revisar el equipo y valorar las opciones disponibles." />
</BaseLayout>
<style>
  .service-links{display:flex;flex-wrap:wrap;align-content:start;gap:.65rem 1.5rem}
  .service-links a{font-size:.93rem}
  .service-contents{background:#202326;border-bottom:1px solid var(--line)}
  .service-contents>.container{display:flex;flex-wrap:wrap;gap:.6rem 1.5rem;padding-block:1.1rem;font-size:.88rem;line-height:1.6}
  .service-contents span{color:var(--muted)}.service-contents a{text-underline-offset:.3em}.service-contents a:hover{color:var(--accent)}
  .service-detail-section{padding-block:clamp(2.5rem,5vw,4.5rem);border-bottom:1px solid var(--line);background:#111416}
  .service-detail-section:nth-child(even){background:#1a1d20}
  .service-detail-section__grid{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.65fr);gap:clamp(2rem,5vw,4.5rem)}
  .service-detail h2{margin:0;font-size:clamp(1.7rem,2.5vw,2.4rem);line-height:1.23}
  .service-detail h3{margin:0;font-size:clamp(1.15rem,1.6vw,1.35rem);line-height:1.35}
  .service-detail p{max-width:66ch;margin:.8rem 0 0;color:var(--muted);font-size:1rem;line-height:1.85}
  .service-detail-section__grid>header{align-self:start;padding-top:1.1rem;border-top:2px solid var(--accent)}
  .service-offerings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 2.25rem}
  .service-offerings article,.service-problems article,.service-guides article{padding:1.5rem 0;border-top:1px solid var(--line)}
  .service-offerings article:nth-child(-n+2),.service-problems article:first-child,.service-guides article:first-child{padding-top:1.1rem}
  .service-process{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;margin:2rem 0 0;padding:0;list-style:none}
  .service-process li{display:flex;gap:1rem;padding-top:1.5rem;border-top:1px solid var(--line)}
  .service-process li>span{color:var(--accent);font-size:.9rem;line-height:1.8;font-variant-numeric:tabular-nums}
  .service-reading p:first-child{margin-top:0}
  .service-local{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);align-items:center;gap:clamp(2rem,5vw,4rem)}
  .service-local figure{margin:0}.service-local img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover}
  .service-guides h3{margin-top:.5rem}.service-guides h3 a{text-decoration:none}.service-guides h3 a:hover{text-decoration:underline;text-underline-offset:.25em}.service-guides h3 span{color:var(--accent)}
  .service-guides .eyebrow{font-size:.72rem;line-height:1.5;color:var(--accent);margin:0}
  @media(max-width:800px){.service-detail-section__grid,.service-local{grid-template-columns:1fr}.service-detail-section__grid{gap:1.75rem}.service-process{grid-template-columns:1fr;gap:1.5rem}.service-local img{max-height:20rem}.service-contents>.container{gap:.5rem 1rem}}
  @media(max-width:520px){.service-offerings{grid-template-columns:1fr}.service-offerings article:nth-child(2){padding-top:1.5rem}.service-contents span{width:100%}}
</style>
